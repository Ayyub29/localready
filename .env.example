# Neon — https://neon.tech (use pooled connection string for serverless)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth.js — https://authjs.dev/getting-started/deployment
AUTH_SECRET=generate_with_openssl_rand_base64_32
# Local: http://localhost:43123 — Cloudflare: https://localready.<your-subdomain>.workers.dev
AUTH_URL=http://localhost:43123

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:43123/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Content pipeline — manual inject + pool filter API (Bearer token)
CONTENT_INJECT_SECRET=

# Admin UI (/admin) — comma-separated Google emails; empty = route hidden (404)
ADMIN_ALLOWLIST=

# Local only: allow /admin without Google allowlist (never enable in production)
ADMIN_DEV_BYPASS=

# Optional — AI phrase seeding script only (never required at runtime)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Payments (M5) — Midtrans QRIS
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false

# Local: simulate paid checkout without Midtrans (enables POST /api/checkout/simulate)
# PAYMENT_DEV_SIMULATE=true
# PAYMENT_WEBHOOK_SECRET=dev_webhook_secret_for_midtrans_simulation

# Grants all content without purchase (local QA)
# DEV_FULL_ACCESS=true

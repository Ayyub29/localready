# Neon — https://neon.tech (use pooled connection string for serverless)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth.js — https://authjs.dev/getting-started/deployment
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_URL=http://localhost:43123

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:43123/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Content pipeline — manual inject + pool filter API (Bearer token)
CONTENT_INJECT_SECRET=

# Admin UI (/admin) — comma-separated Google emails; empty = route hidden (404)
ADMIN_ALLOWLIST=

# Local only: allow /admin without Google allowlist (never enable in production)
ADMIN_DEV_BYPASS=

# Optional — AI phrase seeding script only (never required at runtime)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

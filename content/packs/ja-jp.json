            {
              "id": "ja-jp-emergency-conv-help",
              "situation": "emergency",
              "title": {
                "en": "Ask for help",
                "id": "Minta bantuan"
              },
              "description": {
                "en": "Something went wrong and you need help from someone nearby.",
                "id": "Ada masalah dan kamu butuh bantuan orang di sekitar."
              },
              "turns": [
                {
                  "id": "ja-jp-emergency-conv-help-t1",
                  "role": "traveler",
                  "label": {
                    "en": "You",
                    "id": "Kamu"
                  },
                  "target": "警察をよぶよ！",
                  "romanization": "Keisatsu o yobu yo!",
                  "line": {
                    "en": "I'll call the police.",
                    "id": "Saya akan menelepon polisi."
                  },
                  "phraseId": "ja-jp-emergency-i-ll-call-the-police-0"
                },
                {
                  "id": "ja-jp-emergency-conv-help-t2",
                  "role": "local",
                  "label": {
                    "en": "Someone nearby",
                    "id": "Orang di sekitar"
                  },
                  "line": {
                    "en": "Are you okay? What's wrong?",
                    "id": "Kamu oke? Ada apa?"
                  }
                },
                {
                  "id": "ja-jp-emergency-conv-help-t3",
                  "role": "traveler",
                  "label": {
                    "en": "You",
                    "id": "Kamu"
                  },
                  "target": "警察！",
                  "romanization": "Keisatsu!",
                  "line": {
                    "en": "Police!",
                    "id": "Polisi!"
                  },
                  "phraseId": "ja-jp-emergency-police-1"
                },
                {
                  "id": "ja-jp-emergency-conv-help-t4",
                  "role": "traveler",
                  "label": {
                    "en": "You",
                    "id": "Kamu"
                  },
                  "target": "手伝ってください。",
                  "romanization": "Tetsudatte kudasai.",
                  "line": {
                    "en": "I need your help.",
                    "id": "Saya butuh bantuan Anda."
                  },
                  "phraseId": "ja-jp-emergency-i-need-your-help-2"
                },
                {
                  "id": "ja-jp-emergency-conv-help-t5",
                  "role": "traveler",
                  "label": {
                    "en": "You",
                    "id": "Kamu"
                  },
                  "target": "緊急です。",
                  "romanization": "Kinkyū desu.",
                  "line": {
                    "en": "It's an emergency.",
                    "id": "Ini darurat."
                  },
                  "phraseId": "ja-jp-emergency-it-s-an-emergency-3"
                },
                {
                  "id": "ja-jp-emergency-conv-help-t6",
                  "role": "traveler",
                  "label": {
                    "en": "You",
                    "id": "Kamu"
                  },
                  "target": "道に迷っています。",

                  "id": "ja-jp-basics-conv-polite-t3",
                  "role": "traveler",
                  "label": {
                    "en": "You",
                    "id": "Kamu"
                  },
                  "target": "はい、元気です。",
                  "romanization": "Hai, genki desu.",
                  "line": {
                    "en": "Fine, thank you.",
                    "id": "Baik, terima kasih."
                  },
                  "phraseId": "ja-jp-basics-fine-thank-you-11"

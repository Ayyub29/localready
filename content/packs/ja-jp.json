            "en": "Urgent help",
            "id": "Bantuan darurat"
          },
          "conversation": [
            {
              "id": "ja-jp-emergency-core-t0",
              "role": "narrator",
              "line": {
                "en": "You feel stuck and need help from someone on the street.",
                "id": "Kamu merasa kesulitan dan butuh bantuan orang di jalan."
              }
            },
            {
              "id": "ja-jp-emergency-core-t1",
              "role": "traveler",
              "label": {
                "en": "You",
                "id": "Kamu"
              },
              "target": "警察をよぶよ！",
              "romanization": "Keisatsu o yobu yo!",
              "line": {
                "en": "I'll call the police.",
                "id": "I'll call the police."
              },
              "phraseId": "ja-jp-emergency-i-ll-call-the-police-0"
            },

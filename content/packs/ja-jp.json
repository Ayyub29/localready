                {
                  "id": "ja-jp-basics-conv-polite-t4",
                  "role": "traveler",
                  "label": {
                    "en": "You",
                    "id": "Kamu"
                  },
                  "target": "お願いします。",
                  "romanization": "Onegai shimasu.",
                  "line": {
                    "en": "Please. (request)",
                    "id": "Tolong. (permintaan)"
                  },
                  "phraseId": "ja-jp-basics-please-request-12"
                },
                {
                  "id": "ja-jp-basics-conv-polite-t5",
                  "role": "traveler",
                  "label": {
                    "en": "You",
                    "id": "Kamu"
                  },
                  "target": "どうぞ。",
                  "romanization": "Dōzo.",
                  "line": {
                    "en": "Please. (offer)",
                    "id": "Silakan. (menawarkan)"
                  },
                  "phraseId": "ja-jp-basics-please-offer-13"
                },
                {
                  "id": "ja-jp-basics-conv-polite-t6",
                  "role": "traveler",
                  "label": {
                    "en": "You",
                    "id": "Kamu"

                  "id": "ko-kr-emergency-conv-help-t3",
                  "role": "traveler",
                  "label": {
                    "en": "You",
                    "id": "Kamu"
                  },
                  "target": "경찰!",
                  "romanization": "gyeongchal!",
                  "line": {

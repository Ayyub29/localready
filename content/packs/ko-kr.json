                    "en": "You",
                    "id": "Kamu"
                  },
                  "target": "경찰을 부르겠습니다!",
                  "romanization": "gyeongchareul bureugetseumnida!",
                  "line": {
                    "en": "I'll call the police.",
                    "id": "Saya akan menelepon polisi."
                  },
                  "phraseId": "ko-kr-emergency-i-ll-call-the-police-0"
                },
                {
                  "id": "ko-kr-emergency-conv-help-t2",
                  "role": "local",
                  "label": {
                    "en": "Someone nearby",
                    "id": "Orang di sekitar"
                  },
                  "line": {
                    "en": "Are you okay? What's wrong?",
                    "id": "Kamu oke? Ada apa?"
                  }
                },

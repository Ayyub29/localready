          "conversation": [
            {
              "id": "vi-vn-emergency-core-t0",
              "role": "narrator",
              "line": {
                "en": "You feel stuck and need help from someone on the street.",
                "id": "Kamu merasa kesulitan dan butuh bantuan orang di jalan."
              }
            },
            {
              "id": "vi-vn-emergency-core-t1",
              "role": "traveler",
              "label": {
                "en": "You",
                "id": "Kamu"
              },
              "target": "Tôi sẽ gọi cảnh sát./Tôi sẽ gọi công an.",
              "romanization": "Thoy seEh GAWoy Kanh Sat/ Thoy seEH GAWoy Kong aanh",
              "line": {
                "en": "I'll call the police.",
                "id": "I'll call the police."
              },
              "phraseId": "vi-vn-emergency-i-ll-call-the-police-0"
            },
            {
              "id": "vi-vn-emergency-core-t2",
              "role": "local",
              "label": {
                "en": "Someone nearby",
                "id": "Orang di sekitar"
              },
              "line": {
                "en": "Are you okay? What's wrong?",
                "id": "Kamu oke? Ada apa?"
              }
            },
            {
              "id": "vi-vn-emergency-core-t3",
              "role": "traveler",
              "label": {
                "en": "You",
                "id": "Kamu"
              },
              "target": "Công an!/Cảnh sát!",
              "romanization": "Kong aanh!/Kanh Sat",
              "line": {
